{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "_comment": "Canonical MCP servers for enabled Claude Code, OMP and Codex targets. DEV_CONFIG_MCP_AUTH_SOURCE=op reads 1Password; env uses only environment credentials. Project-specific servers belong in each project's .mcp.json.",
  "mcpServers": {
    "linear-server": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp",
      "auth": {
        "header": "Authorization",
        "prefix": "Bearer ",
        "op": "op://Dev/Linear/MCP_API_KEY",
        "env": "LINEAR_API_KEY"
      }
    },
    "effect-docs": {
      "type": "stdio",
      "command": "bunx",
      "args": ["--bun", "effect-mcp"]
    },
    "vercel": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "cd /tmp && exec npx -y @robinson_ai_systems/vercel-mcp"],
      "auth": {
        "op": "op://Dev/Vercel/TOKEN",
        "env": "VERCEL_MCP_TOKEN",
        "envKey": "VERCEL_TOKEN"
      }
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp/creativetoolkits",
      "auth": {
        "header": "Authorization",
        "prefix": "Sentry-Bearer ",
        "op": "op://Dev/creativetoolkits/SENTRY_MCP_TOKEN",
        "env": "SENTRY_MCP_KEY"
      }
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp",
      "headers": { "x-posthog-mcp-mode": "tools" },
      "auth": {
        "header": "Authorization",
        "prefix": "Bearer ",
        "op": "op://Dev/creativetoolkits/POSTHOG_MCP_TOKEN",
        "env": "POSTHOG_MCP_KEY"
      }
    }
  }
}

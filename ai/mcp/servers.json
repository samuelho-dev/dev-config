{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "_comment": "Canonical MCP server list. Single source of truth fanned out to Claude Code (~/.claude.json), OMP (~/.omp/agent/mcp.json), and Codex (~/.codex/config.toml) by ai/mcp/apply-mcp.sh. Secrets in `auth` resolve via 1Password (auth.op) on nix machines and via the env var (auth.env) in containers. op:// references use named Dev vault items and exact field labels. Project-specific servers belong in each project's .mcp.json, not here.",
  "mcpServers": {
    "linear-server": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp",
      "auth": {
        "header": "Authorization",
        "prefix": "Bearer ",
        "op": "op://Dev/Linear/MCP_API_KEY",
        "env": "LINEAR_API_KEY"
      }
    },
    "effect-docs": {
      "type": "stdio",
      "command": "bunx",
      "args": ["--bun", "effect-mcp@latest"]
    },
    "vercel": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "cd /tmp && exec npx -y @robinson_ai_systems/vercel-mcp@1.0.1"
      ],
      "auth": {
        "op": "op://Dev/Vercel/TOKEN",
        "env": "VERCEL_TOKEN",
        "envKey": "VERCEL_TOKEN"
      }
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp/creativetoolkits",
      "auth": {
        "header": "Authorization",
        "prefix": "Sentry-Bearer ",
        "op": "op://Dev/creativetoolkits-sentry-mcp/TOKEN",
        "env": "SENTRY_MCP_KEY"
      }
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp",
      "headers": { "x-posthog-mcp-mode": "tools" },
      "auth": {
        "header": "Authorization",
        "prefix": "Bearer ",
        "op": "op://Dev/creativetoolkits-posthog-mcp/TOKEN",
        "env": "POSTHOG_MCP_KEY"
      }
    }
  }
}
